# Merged from the original backend (chauhanmis PPC) and frontend
# (ppc-frontend) .gitignore files when they were combined into this
# monorepo. Patterns are left unscoped (no backend/ or frontend/ prefix)
# since gitignore matches a bare "node_modules/"-style pattern at any depth
# — this one file covers both projects' generated folders without needing
# a duplicate per-project entry.

# Dependencies / build output
node_modules/
dist/
dist-ssr/
coverage/

# Env files — real secrets (DATABASE_URL, JWT_SECRET, ADMIN_SEED_PASSWORD,
# VITE_API_BASE_URL, etc.) must never reach GitHub. .env.example files are
# NOT ignored — those are the checked-in templates.
.env
.env.test
.env.local
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
