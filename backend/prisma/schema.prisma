// ============================================================================
// PPC Enterprise — Prisma schema
// Ported 1:1 from the finalized Postgres SQL schema (see README "Assumptions"
// for the handful of naming/serialization decisions made during the port).
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev/test working on whatever platform you run
  // `prisma generate` on; "rhel-openssl-3.0.x" is the engine binary Vercel's
  // Node.js serverless runtime needs, which isn't always auto-detected
  // correctly during a Vercel build. See README "Deploying to Vercel".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUM TYPES
// ----------------------------------------------------------------------------

enum OrderPriority {
  Low
  Medium
  High
}

enum OrderStatus {
  Open
  PendingRM     @map("Pending RM")
  Scheduled
  Running
  QC
  DispatchReady @map("Dispatch Ready")
  Closed
}

enum ScheduleStatus {
  OnTrack    @map("On Track")
  AtRisk     @map("At Risk")
  RMShortage @map("RM Shortage")
}

enum LineStatus {
  Active
  Offline
}

enum UomType {
  Pcs
  Set
  Kg
  Ltr
  Mtr
}

// Module 6 (CTB). Enum, not a free-form string, to match how every other
// status-like field in this schema is already modeled (OrderStatus,
// ScheduleStatus, LineStatus) — see README "Module 6" for why this was
// chosen over the plain `String?` suggested in the spec snippet.
enum CtbStatus {
  ClearToBuild @map("Clear To Build")
  RmShortage   @map("RM Shortage")
}

// Module 9 (Purchase Requisition Automation).
enum PrStatus {
  Draft
  Sent
  Approved
  Fulfilled
  Cancelled
}

// Client Flow Part 1 — Machine master data (see README "Machine master
// data").
enum MachineStatus {
  Active
  Offline
  Maintenance
}

// Client Flow Part 3 — Daily QC Inspection. Distinct from Module 13's
// QcBatch (traceability) — see README "QC Batches vs. QC Inspections".
// Server-derived from quantities on create (see qcInspection.service.ts);
// Pending exists for completeness but is not produced by that derivation —
// see README.
enum QcInspectionStatus {
  Pending
  Passed
  PartialPass
  Rejected
}

// FG Module Part 1 — Finished Goods. Plywood-specific product attributes
// (see README "FG Module Part 1"). `Other` covers grades outside the three
// named ones rather than leaving the field a free-form string, matching how
// every other status/category-like field in this schema is already an enum.
enum PlywoodGrade {
  MR
  BWR
  BWP
  Other
}

// FG Module Part 1. Distinct from QcInspectionStatus above — that's Daily QC
// Inspection's own derived status; this is the FG batch's own QC state.
// `Pending`/`Fail`/`Hold` are not produced by POST /api/fg-batches/generate
// (which only ever fires from an inspection with a real passedQty and always
// creates with `Pass`) — they're reachable later via Part 2's hold
// mechanism. See README "FG Module Part 1".
enum FgQcStatus {
  Pending
  Pass
  Fail
  Hold
}

// FG Module Part 1. Available stock is never a stored value — see
// `computeAvailableQty` in fgBatch.service.ts and README "FG Module Part 1"
// for why. This enum is the batch's own held-vs-free-vs-reserved state, set
// by Part 2's future reservation/hold actions (Part 1 only ever creates a
// batch as `Available`).
enum FgStockStatus {
  Available
  Reserved
  Hold
}

// FG Module Part 1. `Ready` is the default on generate — see README "FG
// Module Part 1" for why a freshly QC-passed batch starts dispatch-eligible
// rather than `NotReady`. `Partial`/`Dispatched` are set later by Part 4's
// dispatch actions.
enum FgDispatchStatus {
  NotReady
  Ready
  Partial
  Dispatched
}

// FG Module Part 2 — the audit ledger's own event vocabulary. Reserved/
// Unreserved/Dispatched aren't written by anything in Part 2 itself (Parts
// 3-4 build reservation/dispatch) — listed here now so the enum is
// complete/stable from the start rather than migrated twice. See README
// "FG Module Part 2".
enum FgMovementType {
  BatchCreated
  WarehouseTransfer
  Reserved
  Unreserved
  Dispatched
  Held
  HoldReleased
  Adjustment
}

// FG Module Part 3. A Sales Order's own fulfillment-progress state, derived
// (never directly settable) from summing its Active FgReservations against
// orderedQty — see `recomputeSalesOrderStatus` in salesOrders.service.ts.
// PartiallyDispatched/Dispatched/Closed are not reachable yet — no dispatch
// endpoint exists in this codebase until Part 4; declared now so the enum is
// complete/stable from the start rather than migrated twice, same reasoning
// as FgMovementType above.
enum SalesOrderStatus {
  Open
  PartiallyReserved
  FullyReserved
  PartiallyDispatched
  Dispatched
  Closed
}

// FG Module Part 3. An FgReservation's own lifecycle: Active is the only
// state a reservation is created in; Cancelled is set by POST
// /api/fg-reservations/:id/cancel (this part); Fulfilled is reserved for
// Part 4's dispatch to set once a reservation's stock has actually shipped
// — not reachable by anything built in this part.
enum FgReservationStatus {
  Active
  Cancelled
  Fulfilled
}

// ============================================================================
// 1. MODEL MASTER
// ============================================================================
model Product {
  modelId           String   @id @map("model_id")
  modelName         String   @map("model_name")
  productType       String   @map("product_type")
  sku               String   @unique
  taktTimeSec       Decimal  @map("takt_time_sec") @db.Decimal(10, 2)
  manpowerRequired  Int      @map("manpower_required")
  noOfStations      Int      @map("no_of_stations")
  changeoverTimeMin Decimal? @map("changeover_time_min") @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  // FG Module Part 1 — plywood-specific attributes, all nullable since not
  // every product in this system is plywood (see README "FG Module Part
  // 1"). Product-level defaults an FG batch can pull from at generation
  // time; a specific batch's own fields can still differ (see
  // fgBatch.schema.ts).
  plywoodGrade PlywoodGrade? @map("plywood_grade")
  thickness    Decimal?      @db.Decimal(6, 2)
  sheetLength  Decimal?      @map("sheet_length") @db.Decimal(8, 2)
  sheetWidth   Decimal?      @map("sheet_width") @db.Decimal(8, 2)

  bomComponents BomComponent[]
  orders        Order[]
  dailyLogs     DailyProductionLog[]

  @@index([productType])
  @@map("products")
}

// ============================================================================
// 2. RM INVENTORY
// ============================================================================
model RmInventory {
  partId    String   @id @map("part_id")
  stock     Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  // Module 7 (Material Dashboard). Null = no threshold set for this part,
  // which deliberately means "never appears in the critical list" — see
  // README "Module 7" for why no global default is guessed.
  criticalThreshold Decimal? @map("critical_threshold") @db.Decimal(12, 2)

  bomComponents BomComponent[]
  transactions  RmTransaction[]

  @@map("rm_inventory")
}

// ============================================================================
// 3. BOM MASTER
// ============================================================================
model BomComponent {
  id         BigInt   @id @default(autoincrement())
  modelRef   String   @map("model_ref")
  uom        UomType  @default(Pcs)
  partName   String   @map("part_name")
  qtyPerUnit Decimal  @default(1) @map("qty_per_unit") @db.Decimal(10, 3)
  partId     String?  @map("part_id")
  createdAt  DateTime @default(now()) @map("created_at")

  product     Product      @relation(fields: [modelRef], references: [sku])
  rmInventory RmInventory? @relation(fields: [partId], references: [partId])

  @@index([modelRef])
  @@index([partName])
  @@map("bom_components")
}

// ============================================================================
// 4. LINES
// ============================================================================
model ProductionLine {
  lineId        String     @id @map("line_id")
  lineName      String     @map("line_name")
  maxWorkers    Int        @map("max_workers")
  efficiencyPct Decimal    @map("efficiency_pct") @db.Decimal(5, 2)
  status        LineStatus @default(Active)
  notes         String?
  capPerDay     Decimal?   @map("cap_per_day") @db.Decimal(10, 2)

  compatibility LineProductCompatibility[]
  hrTeams       HrTeam[]
  schedules     ProductionSchedule[]
  dailyLogs     DailyProductionLog[]
  machines      Machine[]

  @@map("production_lines")
}

model LineProductCompatibility {
  lineId      String @map("line_id")
  productType String @map("product_type")

  line ProductionLine @relation(fields: [lineId], references: [lineId], onDelete: Cascade)

  @@id([lineId, productType])
  @@map("line_product_compatibility")
}

// ============================================================================
// CLIENT FLOW PART 1 — MACHINE MASTER DATA
//
// We previously only tracked capacity/status at the Line level. The client's
// detailed flow document tracks individual Machines within a Line (a Line can
// have several) — see README "Machine master data" for the full rationale
// and how this feeds Part 2's Daily Production Plan.
// ============================================================================
model Machine {
  id               BigInt        @id @default(autoincrement())
  machineId        String        @unique @map("machine_id")
  machineName      String        @map("machine_name")
  lineId           String        @map("line_id")
  // At least one of the three capacity fields must be present — enforced at
  // the Zod layer (see machines.schema.ts), not a DB constraint. If more
  // than one is given, they are stored as-is with no attempt to reconcile
  // them against each other (e.g. capacityPerShift need not equal
  // capacityPerHour * shift hours) — see README.
  capacityPerHour  Decimal?      @map("capacity_per_hour") @db.Decimal(10, 2)
  capacityPerShift Decimal?      @map("capacity_per_shift") @db.Decimal(10, 2)
  capacityPerDay   Decimal?      @map("capacity_per_day") @db.Decimal(10, 2)
  status           MachineStatus @default(Active)
  notes            String?

  line ProductionLine @relation(fields: [lineId], references: [lineId])

  @@index([lineId])
  @@map("machines")
}

// ============================================================================
// 5. HR
// ============================================================================
model HrTeam {
  teamId        String   @id @map("team_id")
  teamName      String   @map("team_name")
  lineId        String?  @map("line_id")
  workers       Int
  skill         String?
  attendancePct Decimal? @map("attendance_pct") @db.Decimal(5, 2)
  shift         String?
  notes         String?

  line ProductionLine? @relation(fields: [lineId], references: [lineId])

  @@map("hr_teams")
}

// ============================================================================
// 6. HISTORY (monthly rollup)
// ============================================================================
model ProductionHistory {
  id             BigInt   @id @default(autoincrement())
  month          String
  year           Int
  plannedQty     Decimal? @map("planned_qty") @db.Decimal(12, 2)
  actualQty      Decimal? @map("actual_qty") @db.Decimal(12, 2)
  achievementPct Decimal? @map("achievement_pct") @db.Decimal(5, 2)
  downtimePct    Decimal? @map("downtime_pct") @db.Decimal(5, 2)
  notes          String?

  @@unique([month, year])
  @@map("production_history")
}

// ============================================================================
// 7. ORDERS
// ============================================================================
model Order {
  orderId   String        @id @map("order_id")
  client    String
  sku       String
  product   String
  qty       Int
  dueDate   DateTime?     @map("due_date") @db.Date
  priority  OrderPriority @default(Medium)
  status    OrderStatus   @default(Open)
  createdAt DateTime      @default(now()) @map("created_at")

  // Module 6 (CTB). Both nullable: null/null means "never evaluated" —
  // distinguished from a real evaluation via ctbCheckedAt, not a sentinel
  // status value. See README "Module 6".
  ctbStatus    CtbStatus? @map("ctb_status")
  ctbCheckedAt DateTime?  @map("ctb_checked_at")

  // Client Flow Part 1 — free-text field for anything about this order that
  // doesn't fit the structured columns (special packaging, client-specific
  // labeling, etc.). Additive, optional, no other logic attached — see README.
  specialRequirements String? @map("special_requirements")

  productRef      Product               @relation(fields: [sku], references: [sku])
  statusHistory   OrderStatusHistory[]
  schedules       ProductionSchedule[]
  bomRequirements OrderBomRequirement[]
  ctbShortages    OrderCtbShortage[]
  qcBatch         QcBatch?
  dailyLogs       DailyProductionLog[]
  productionPlan  DailyProductionPlan[]
  qcInspections   DailyQcInspection[]
  closureSummary  OrderClosureSummary?
  fgBatches       FgBatch[]

  @@index([status])
  @@index([sku])
  @@index([dueDate])
  @@map("orders")
}

model OrderStatusHistory {
  id        BigInt       @id @default(autoincrement())
  orderId   String       @map("order_id")
  oldStatus OrderStatus? @map("old_status")
  newStatus OrderStatus  @map("new_status")
  changedBy String?      @map("changed_by")
  changedAt DateTime     @default(now()) @map("changed_at")
  // Added for Module 10's un-schedule reversal (DELETE
  // /api/scheduling/schedule/:orderId): the original schema had no place to
  // record why a status change happened, only who and when. Nullable and
  // additive — every prior history row simply has notes: null.
  notes     String?

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("order_status_history")
}

// ============================================================================
// 8. SCHEDULE
// ============================================================================
model ProductionSchedule {
  id              BigInt         @id @default(autoincrement())
  // Made unique for Module 10: the scheduling engine's eligibility rule
  // ("no existing production_schedule row yet") and GET
  // /api/scheduling/schedule/:orderId (a single-row-per-order lookup) both
  // assume one schedule row per order — this constraint enforces that
  // invariant at the DB level instead of only by convention.
  orderId         String         @unique @map("order_id")
  client          String
  sku             String
  product         String
  qty             Int
  lineId          String?        @map("line_id")
  lineName        String?        @map("line_name")
  dailyOutput     Decimal?       @map("daily_output") @db.Decimal(10, 2)
  workersPresent  Int?           @map("workers_present")
  workersRequired Int?           @map("workers_required")
  shiftMode       String?        @map("shift_mode")
  daysNeeded      Decimal?       @map("days_needed") @db.Decimal(6, 2)
  startDate       DateTime?      @map("start_date") @db.Date
  estEndDate      DateTime?      @map("est_end_date") @db.Date
  dueDate         DateTime?      @map("due_date") @db.Date
  slackDays       Int?           @map("slack_days")
  status          ScheduleStatus @default(OnTrack)
  createdAt       DateTime       @default(now()) @map("created_at")

  order Order           @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  line  ProductionLine? @relation(fields: [lineId], references: [lineId])

  @@index([status])
  @@index([lineId])
  @@map("production_schedule")
}

// ============================================================================
// CLIENT FLOW PART 2 — DAILY PRODUCTION PLAN
//
// A day-by-day plan generated once an order has a production_schedule row
// (Module 10) — one row per calendar day from the schedule's startDate to
// estEndDate, plannedQty distributed across days by planDistributor.ts. See
// README "Client Flow Part 2" for the distribution algorithm, the explicit
// generate-on-demand convention, and why machineId stays null for now.
// ============================================================================
model DailyProductionPlan {
  id         BigInt   @id @default(autoincrement())
  orderId    String   @map("order_id")
  planDate   DateTime @map("plan_date") @db.Date
  lineId     String?  @map("line_id")
  machineId  String?  @map("machine_id")
  plannedQty Decimal  @map("planned_qty") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@unique([orderId, planDate])
  @@map("daily_production_plan")
}

// ============================================================================
// 9. DAILY LOG
// ============================================================================
model DailyProductionLog {
  logId              String   @id @map("log_id")
  logDate            DateTime @map("log_date") @db.Date
  shift              String?
  lineId             String?  @map("line_id")
  lineName           String?  @map("line_name")
  activeLinesCount   Int?     @map("active_lines_count")
  modelId            String?  @map("model_id")
  modelName          String?  @map("model_name")
  totalEmployees     Int?     @map("total_employees")
  presentEmployees   Int?     @map("present_employees")
  absentEmployees    Int?     @map("absent_employees")
  attendancePct      Decimal? @map("attendance_pct") @db.Decimal(5, 2)
  taktTimeOverride   Decimal? @map("takt_time_override") @db.Decimal(10, 2)
  manpowerOverride   Int?     @map("manpower_override")
  notes              String?
  // Station-wise worker assignment, e.g. {"Element": ["ajit","suresh"], "Pully": ["karan","arjun"]}
  stationAssignments Json?    @map("station_assignments")
  savedBy            String?  @map("saved_by")
  savedAt            DateTime @default(now()) @map("saved_at")

  // Added for Module 4 (OEE). The original sheet-derived Daily Log never
  // captured output quantity, so Performance%/Quality% had no data to work
  // from — see README "Schema gap" note. Purely additive, nullable so
  // pre-Module-4 rows and any client not yet aware of them are unaffected.
  plannedMinutes Decimal? @map("planned_minutes") @db.Decimal(10, 2)
  totalOutputQty Decimal? @map("total_output_qty") @db.Decimal(12, 2)
  goodQty        Decimal? @map("good_qty") @db.Decimal(12, 2)

  // Client Flow Part 1. Closes the gap Module 12 documented (search's
  // pendingQty was always null because daily logs were never linked to a
  // specific order — see README "orderId gap-closure"). Nullable: historical
  // rows and any non-order-specific logging remain valid.
  orderId String? @map("order_id")

  // Production team's own self-reported reject/rework figures — distinct
  // from QC's authoritative pass/reject numbers (Part 3, not yet built). Both
  // are kept, never merged into one, for audit/comparison — see README.
  rejectedQty Decimal? @map("rejected_qty") @db.Decimal(12, 2)
  reworkQty   Decimal? @map("rework_qty") @db.Decimal(12, 2)

  line         ProductionLine? @relation(fields: [lineId], references: [lineId])
  model        Product?        @relation(fields: [modelId], references: [modelId])
  order        Order?          @relation(fields: [orderId], references: [orderId])
  downtimeLogs DowntimeLog[]

  @@index([logDate])
  @@index([lineId])
  @@index([modelId])
  @@index([orderId])
  @@map("daily_production_log")
}

model DowntimeLog {
  id      BigInt  @id @default(autoincrement())
  logId   String  @map("log_id")
  reason  String
  minutes Decimal @db.Decimal(10, 2)
  notes   String?

  dailyLog DailyProductionLog @relation(fields: [logId], references: [logId], onDelete: Cascade)

  @@map("downtime_log")
}

// ============================================================================
// 10. MANPOWER FORECAST
// ============================================================================
model ManpowerForecast {
  forecastDate DateTime @id @map("forecast_date") @db.Date
  day          String?
  headcount    Int?
  notes        String?

  @@map("manpower_forecast")
}

// ============================================================================
// RM STOCK LEDGER (added for Module 1 adjust-stock endpoint — not present in
// the original sheet-derived SQL, called out explicitly as needed in the spec)
// ============================================================================
model RmTransaction {
  id        BigInt   @id @default(autoincrement())
  partId    String   @map("part_id")
  delta     Decimal  @db.Decimal(12, 2)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  rmInventory RmInventory @relation(fields: [partId], references: [partId], onDelete: Cascade)

  @@index([partId])
  @@map("rm_transactions")
}

// ============================================================================
// MODULE 5 — BOM EXPLOSION (materialized cache of an order's exploded
// requirements; see README "Module 5 — BOM Explosion Engine")
// ============================================================================
model OrderBomRequirement {
  id          BigInt   @id @default(autoincrement())
  orderId     String   @map("order_id")
  partId      String?  @map("part_id")
  partName    String   @map("part_name")
  qtyPerUnit  Decimal  @map("qty_per_unit") @db.Decimal(10, 3)
  requiredQty Decimal  @map("required_qty") @db.Decimal(12, 3)
  computedAt  DateTime @default(now()) @map("computed_at")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId])
  @@map("order_bom_requirements")
}

// ============================================================================
// MODULE 6 — CTB (materialized per-part shortage breakdown for the last
// live CTB evaluation of an order; see README "Module 6 — CTB Engine" for
// why this table exists beyond the ctbStatus/ctbCheckedAt columns the spec
// asked for — it's what lets the dashboard endpoint show shortages without
// re-evaluating every order on every call).
// ============================================================================
model OrderCtbShortage {
  id             BigInt   @id @default(autoincrement())
  orderId        String   @map("order_id")
  partId         String?  @map("part_id")
  partName       String   @map("part_name")
  requiredQty    Decimal  @map("required_qty") @db.Decimal(12, 3)
  availableStock Decimal  @map("available_stock") @db.Decimal(12, 3)
  shortQty       Decimal  @map("short_qty") @db.Decimal(12, 3)
  evaluatedAt    DateTime @default(now()) @map("evaluated_at")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId])
  @@map("order_ctb_shortages")
}

// ============================================================================
// MODULE 9 — PURCHASE REQUISITION AUTOMATION (consolidated net purchase
// requirement across ALL active orders at once; see README "Module 9" for
// why this deliberately recomputes demand instead of reusing Modules 6/7/8's
// per-order shortage numbers).
// ============================================================================
model PurchaseRequisition {
  id            BigInt            @id @default(autoincrement())
  prNumber      String            @unique @map("pr_number")
  status        PrStatus          @default(Draft)
  generatedBy   String?           @map("generated_by")
  generatedAt   DateTime          @default(now()) @map("generated_at")
  notes         String?
  lineItems     PrLineItem[]
  statusHistory PrStatusHistory[]

  @@index([status])
  @@map("purchase_requisitions")
}

model PrLineItem {
  id                BigInt  @id @default(autoincrement())
  prId              BigInt  @map("pr_id")
  partId            String? @map("part_id")
  partName          String  @map("part_name")
  totalRequiredQty  Decimal @map("total_required_qty") @db.Decimal(12, 3)
  currentStockQty   Decimal @map("current_stock_qty") @db.Decimal(12, 3)
  netRequirementQty Decimal @map("net_requirement_qty") @db.Decimal(12, 3)

  pr PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
  @@map("pr_line_items")
}

model PrStatusHistory {
  id        BigInt    @id @default(autoincrement())
  prId      BigInt    @map("pr_id")
  oldStatus PrStatus? @map("old_status")
  newStatus PrStatus  @map("new_status")
  changedBy String?   @map("changed_by")
  changedAt DateTime  @default(now()) @map("changed_at")

  pr PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
  @@map("pr_status_history")
}

// ============================================================================
// MODULE 13 — QC PLANNING INTEGRATION (generation/storage of the QC batch
// data an external PRO_QC system would eventually consume; see README
// "Module 13" — there is no real external system yet, so this is the
// generation + storage half only).
// ============================================================================
model TestingPlan {
  id          BigInt    @id @default(autoincrement())
  productType String    @unique @map("product_type")
  planName    String    @map("plan_name")
  description String?
  qcBatches   QcBatch[]

  @@map("testing_plans")
}

model QcBatch {
  id               BigInt   @id @default(autoincrement())
  orderId          String   @unique @map("order_id")
  sku              String
  batchNumber      String   @unique @map("batch_number")
  barcodeValue     String   @map("barcode_value")
  serialRangeStart BigInt   @map("serial_range_start")
  serialRangeEnd   BigInt   @map("serial_range_end")
  testingPlanId    BigInt?  @map("testing_plan_id")
  generatedAt      DateTime @default(now()) @map("generated_at")

  order       Order        @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  testingPlan TestingPlan? @relation(fields: [testingPlanId], references: [id])

  @@map("qc_batches")
}

// ============================================================================
// CLIENT FLOW PART 3 — DAILY QC INSPECTION (distinct from QcBatch above —
// this is daily pass/reject/rework tracking, not batch traceability. See
// README "QC Batches vs. QC Inspections").
// ============================================================================
model DailyQcInspection {
  id             BigInt             @id @default(autoincrement())
  orderId        String             @map("order_id")
  inspectionDate DateTime           @map("inspection_date") @db.Date
  // Optional link to the daily_production_log row this QC's — validated (if
  // provided) to exist AND belong to the same orderId at the service layer,
  // not a DB-level FK (matching how Part 2's lineId/machineId on
  // daily_production_plan are also plain, unenforced strings). See README.
  dailyLogId     String?            @map("daily_log_id")
  producedQty    Decimal            @map("produced_qty") @db.Decimal(12, 2)
  sampleQty      Decimal?           @map("sample_qty") @db.Decimal(12, 2)
  passedQty      Decimal            @map("passed_qty") @db.Decimal(12, 2)
  rejectedQty    Decimal            @map("rejected_qty") @db.Decimal(12, 2)
  reworkQty      Decimal            @default(0) @map("rework_qty") @db.Decimal(12, 2)
  defectType     String?            @map("defect_type")
  qcStatus       QcInspectionStatus @map("qc_status")
  remarks        String?
  inspectorName  String             @map("inspector_name")
  createdAt      DateTime           @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  fgBatch FgBatch?

  @@index([orderId])
  @@index([inspectionDate])
  @@map("daily_qc_inspections")
}

// ============================================================================
// CLIENT FLOW PART 4B — ORDER CLOSURE SUMMARY
//
// One row per order, captured automatically (never written directly by a
// user) the moment its status transition reaches Closed — see
// orders.service.ts's updateOrderStatus and README "Client Flow Part 4" for
// the hook-into-transition pattern this follows (same shape as Module 9's
// Fulfilled -> stock-credit hook).
// ============================================================================
model OrderClosureSummary {
  id                    BigInt    @id @default(autoincrement())
  orderId               String    @unique @map("order_id")
  totalOrderedQty       Decimal   @map("total_ordered_qty") @db.Decimal(12, 2)
  totalProducedQty      Decimal   @map("total_produced_qty") @db.Decimal(12, 2)
  totalQcPassedQty      Decimal   @map("total_qc_passed_qty") @db.Decimal(12, 2)
  totalRejectedQty      Decimal   @map("total_rejected_qty") @db.Decimal(12, 2)
  totalReworkQty        Decimal   @map("total_rework_qty") @db.Decimal(12, 2)
  plannedCompletionDate DateTime? @map("planned_completion_date") @db.Date
  actualCompletionDate  DateTime  @default(now()) @map("actual_completion_date") @db.Date
  // Signed: positive = closed after plannedCompletionDate (late), negative =
  // closed early, null only when there was no schedule to compare against.
  delayDays             Int?      @map("delay_days")
  delayReason           String?   @map("delay_reason")
  finalRemarks          String?   @map("final_remarks")

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@map("order_closure_summaries")
}

// ============================================================================
// FG MODULE PART 1 — WAREHOUSE + FG BATCH CORE
//
// New, separate module (not part of the 5-part Client Flow addition above,
// though it reuses several of that addition's pieces — the Daily QC
// Inspection module, the sequential-id generator). Built for the plywood
// manufacturing client's own requirement: QC-passed production must become
// traceable, warehouse-located, reservable, dispatch-eligible stock — never
// a manually-entered quantity. See README "FG Module Part 1" for the full
// design rationale, including the availableQty-always-computed decision and
// the role-split judgment call.
// ============================================================================

model Warehouse {
  id            BigInt  @id @default(autoincrement())
  warehouseId   String  @unique @map("warehouse_id")
  warehouseName String  @map("warehouse_name")
  location      String?
  isActive      Boolean @default(true) @map("is_active")

  @@map("warehouses")
}

// One row per QC-passed batch, created only via POST /api/fg-batches/generate
// from an existing Daily QC Inspection — never a direct manual insert of a
// quantity. `qcInspectionId`'s `@unique` is the DB-level enforcement of the
// 1:1 QC-Inspection-to-FG-Batch trigger design (see README): an inspection
// can produce at most one FG batch, ever.
//
// `warehouseId` is a plain, service-validated string, not a DB-level FK —
// same "soft reference" pattern as Part 2/3's lineId/machineId/dailyLogId on
// daily_production_plan/daily_qc_inspections (see those models' own
// comments) — Part 2 of this module will build the actual warehouse-
// assignment/transfer actions against it. `salesOrderId` STILL has no
// relation, even now that FG Module Part 3 defines a real SalesOrder table
// — it is effectively superseded, not wired up, by that part's
// FgReservation join table instead (a batch can be split across several
// Sales Orders, and a Sales Order fulfilled by several batches, which a
// single FK here could never express). Left as-is (a plain, unenforced,
// deprecated-in-practice field) rather than removed, to avoid an unrelated
// breaking schema change — see README "FG Module Part 3".
model FgBatch {
  id                BigInt           @id @default(autoincrement())
  fgBatchNo         String           @unique @map("fg_batch_no")
  productionOrderId String           @map("production_order_id")
  qcInspectionId    BigInt           @unique @map("qc_inspection_id")
  salesOrderId      BigInt?          @map("sales_order_id")
  customer          String?
  productName       String           @map("product_name")
  sku               String
  plywoodGrade      PlywoodGrade?    @map("plywood_grade")
  thickness         Decimal?         @db.Decimal(6, 2)
  sheetLength       Decimal?         @map("sheet_length") @db.Decimal(8, 2)
  sheetWidth        Decimal?         @map("sheet_width") @db.Decimal(8, 2)
  productionDate    DateTime         @map("production_date") @db.Date
  producedQty       Decimal          @map("produced_qty") @db.Decimal(12, 2)
  qcPassedQty       Decimal          @map("qc_passed_qty") @db.Decimal(12, 2)
  reworkQty         Decimal          @default(0) @map("rework_qty") @db.Decimal(12, 2)
  rejectedQty       Decimal          @default(0) @map("rejected_qty") @db.Decimal(12, 2)
  qcStatus          FgQcStatus       @default(Pass) @map("qc_status")
  warehouseId       String?          @map("warehouse_id")
  rackBinLocation   String?          @map("rack_bin_location")
  // reservedQty/dispatchedQty are only ever written by Part 2/4's future
  // reservation/dispatch actions — Part 1's generate endpoint always creates
  // a batch with both at their schema default (0). `availableQty` is
  // DELIBERATELY NOT a column here — see README "FG Module Part 1": it is
  // always computed as qcPassedQty - reservedQty - dispatchedQty at
  // read/serialization time (computeAvailableQty in fgBatch.service.ts), to
  // make drift between a stored total and its components structurally
  // impossible rather than something to remember to keep in sync.
  reservedQty       Decimal          @default(0) @map("reserved_qty") @db.Decimal(12, 2)
  dispatchedQty     Decimal          @default(0) @map("dispatched_qty") @db.Decimal(12, 2)
  stockStatus       FgStockStatus    @default(Available) @map("stock_status")
  dispatchStatus    FgDispatchStatus @default(Ready) @map("dispatch_status")
  createdBy         String           @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")

  order        Order             @relation(fields: [productionOrderId], references: [orderId])
  qcInspection DailyQcInspection @relation(fields: [qcInspectionId], references: [id])
  movements    FgStockMovement[]
  // FG Module Part 3 — the real, quantity-aware link to Sales Orders (see
  // SalesOrder/FgReservation's own comments for why this supersedes the
  // plain salesOrderId field above rather than that field gaining an FK).
  reservations FgReservation[]
  // FG Module Part 4 — every dispatch event that has drawn stock from this
  // batch (see FgDispatchLineItem's own comment).
  dispatchLineItems FgDispatchLineItem[]

  @@index([productionOrderId])
  @@index([warehouseId])
  @@index([stockStatus])
  @@index([dispatchStatus])
  @@map("fg_batches")
}

// FG Module Part 2 — the audit ledger: "Every stock movement ka date, user,
// quantity aur source/destination record ho" (the client's own spec,
// quoted in README "FG Module Part 2"). Every write in this whole module
// (this part's WarehouseTransfer/Held/HoldReleased, Part 1's own
// BatchCreated retrofitted in alongside it, and Parts 3-4's future
// Reserved/Unreserved/Dispatched) goes through the one shared
// `logFgMovement` in fgStockMovement.service.ts — never a hand-rolled
// insert per action. `quantity`/`fromLocation`/`toLocation` are all
// nullable because not every movement type involves a quantity (Held/
// HoldReleased don't) or a location change (Reserved/Unreserved/Dispatched
// don't move the batch physically).
model FgStockMovement {
  id           BigInt         @id @default(autoincrement())
  fgBatchId    BigInt         @map("fg_batch_id")
  movementType FgMovementType @map("movement_type")
  quantity     Decimal?       @db.Decimal(12, 2)
  fromLocation String?        @map("from_location")
  toLocation   String?        @map("to_location")
  performedBy  String         @map("performed_by")
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  fgBatch FgBatch @relation(fields: [fgBatchId], references: [id], onDelete: Cascade)

  @@index([fgBatchId])
  @@map("fg_stock_movements")
}

// FG Module Part 3 — a real entity, not just the plain unenforced
// `fg_batches.sales_order_id` text/id reference Part 1 left as "a future
// part to define" (see FgBatch's own comment above). One Sales Order can be
// fulfilled by several FG batches over time, and partially at that — that's
// exactly what FgReservation (a join row with its own quantity) exists to
// track; `fg_batches.sales_order_id` itself is NOT wired to this table (no
// FK added to FgBatch in this part — see README "FG Module Part 3" for why
// that field is now effectively superseded by FgReservation rather than
// reused). `status` is never directly settable by a caller — always
// recomputed by `recomputeSalesOrderStatus` off the real reservation rows.
model SalesOrder {
  id           BigInt           @id @default(autoincrement())
  salesOrderNo String           @unique @map("sales_order_no")
  customer     String
  sku          String
  orderedQty   Decimal          @map("ordered_qty") @db.Decimal(12, 2)
  status       SalesOrderStatus @default(Open)
  dueDate      DateTime?        @map("due_date") @db.Date
  createdBy    String           @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")

  reservations FgReservation[]
  // FG Module Part 4.
  dispatches   FgDispatch[]

  @@map("sales_orders")
}

// FG Module Part 3 — the partial-reservation join row: one row per
// "this much of this FG batch is set aside for this Sales Order" event.
// `status` starts Active on every reservation (the only way one is ever
// created) and moves to Cancelled via POST /api/fg-reservations/:id/cancel
// (this part) or Fulfilled once Part 4's dispatch consumes it (not
// reachable by anything built in this part). Never physically deleted —
// Cancelled/Fulfilled rows stay as the historical record the client's
// spec's "partial-fulfillment tracking" view (GET
// /api/sales-orders/:salesOrderNo/reservations) reads.
model FgReservation {
  id           BigInt               @id @default(autoincrement())
  fgBatchId    BigInt               @map("fg_batch_id")
  salesOrderId BigInt               @map("sales_order_id")
  reservedQty  Decimal              @map("reserved_qty") @db.Decimal(12, 2)
  status       FgReservationStatus  @default(Active)
  reservedBy   String               @map("reserved_by")
  reservedAt   DateTime             @default(now()) @map("reserved_at")

  fgBatch    FgBatch    @relation(fields: [fgBatchId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])

  @@index([fgBatchId])
  @@index([salesOrderId])
  @@index([status])
  @@map("fg_reservations")
}

// FG Module Part 4 — one dispatch EVENT, which can cover several FG batches
// in a single transaction (see FgDispatchLineItem). `salesOrderId` — unlike
// the same-named, deliberately-unwired field Part 1 left on FgBatch — DOES
// get a real relation here: a dispatch genuinely belongs to at most one real
// Sales Order (or none, for general/unaffiliated stock movement), so there's
// no many-to-many shape to worry about the way there was for FgBatch <->
// SalesOrder (that's what FgReservation/FgDispatchLineItem, the actual join
// tables, are for). No `onDelete: Cascade` — same as FgReservation.
// salesOrderId — so a Sales Order with any dispatch history, like one with
// any reservation history, can never be silently deleted out from under it.
model FgDispatch {
  id           BigInt    @id @default(autoincrement())
  dispatchNo   String    @unique @map("dispatch_no")
  salesOrderId BigInt?   @map("sales_order_id")
  dispatchDate DateTime  @default(now()) @map("dispatch_date") @db.Date
  dispatchedBy String    @map("dispatched_by")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  salesOrder SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  lineItems  FgDispatchLineItem[]

  @@index([salesOrderId])
  @@index([dispatchDate])
  @@map("fg_dispatches")
}

// FG Module Part 4 — one row per FG batch drawn on within a dispatch event;
// what actually lets one dispatch cover several batches in one transaction.
// `quantity` is netted against the batch's own reservedQty (for the
// dispatch's salesOrderId specifically) before availableQty — see
// `processDispatchLineItem` in fgDispatch.service.ts for the exact order,
// and README "FG Module Part 4" for the full rationale. Never edited after
// creation, same "audit-trail row" convention as FgStockMovement — a
// dispatch, once made, is a historical fact.
model FgDispatchLineItem {
  id         BigInt   @id @default(autoincrement())
  dispatchId BigInt   @map("dispatch_id")
  fgBatchId  BigInt   @map("fg_batch_id")
  quantity   Decimal  @db.Decimal(12, 2)

  dispatch FgDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  fgBatch  FgBatch    @relation(fields: [fgBatchId], references: [id])

  @@index([dispatchId])
  @@index([fgBatchId])
  @@map("fg_dispatch_line_items")
}

// ============================================================================
// AUTHENTICATION & ROLE-BASED AUTHORIZATION (cross-cutting retrofit — see
// README "Authentication & Authorization" for the role model, the full
// permission matrix, and the JWT/no-refresh-token simplification).
// ============================================================================
enum UserRole {
  Admin
  StoreManager
  ProductionManager
}

model User {
  id                 BigInt   @id @default(autoincrement())
  email              String   @unique
  passwordHash       String   @map("password_hash")
  name               String
  role               UserRole
  isActive           Boolean  @default(true) @map("is_active")
  // Self-service "Forgot Password" identity check — see
  // README "Self-Service Password Reset". Both required: every user must
  // have a real one before self-service reset works for them. Existing
  // (pre-migration) users are backfilled with the sentinel
  // SECURITY_QUESTION_NOT_SET, which the forgot-password flow explicitly
  // detects and rejects with a message pointing at an Admin fixing it via
  // PATCH /api/auth/users/:userId, rather than silently failing.
  securityQuestion   String   @map("security_question")
  securityAnswerHash String   @map("security_answer_hash")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Single-use, short-lived password-reset tokens issued by
// POST /api/auth/forgot-password/verify and consumed by
// POST /api/auth/forgot-password/reset. tokenHash is a SHA-256 digest of the
// full signed reset-token JWT (not the password JWT itself, which is never
// stored) — a fast hash is appropriate here (unlike bcrypt for passwords)
// because the token is high-entropy, randomly generated, single-use, and
// short-lived, not a low-entropy human-chosen secret. See README.
model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}
