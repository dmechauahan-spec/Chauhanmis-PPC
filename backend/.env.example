# Primary database connection (Neon / Supabase Postgres connection string)
DATABASE_URL=""

# Separate database used only when running the test suite (npm run test).
# Point this at a throwaway Neon/Supabase branch or database — tests will
# write and delete data in it. Never point this at production data.
DATABASE_URL_TEST=""

# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Authentication & Authorization
# Secret used to sign/verify JWT access tokens. Must be at least 32
# characters (enforced at startup — the app refuses to boot otherwise).
# Generate a real, random value locally (e.g. `openssl rand -hex 32`, which
# produces 64 hex characters) — never commit the real secret.
JWT_SECRET=""

# Bootstrap-only: prisma/seed.ts creates the first Admin user from these two
# values (only used when running the seed script). Change this password
# after first login — see README "Authentication & Authorization".
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="change-me-after-first-login"

# Bootstrap-only, same as above: the seeded Admin's security question/answer
# for self-service password reset (see README "Self-Service Password Reset").
# ADMIN_SEED_SECURITY_QUESTION must be one of SECURITY_QUESTIONS in
# src/modules/auth/securityQuestion.ts, verbatim. Change the answer after
# first login, same as the password.
ADMIN_SEED_SECURITY_QUESTION="What city were you born in?"
ADMIN_SEED_SECURITY_ANSWER="change-me-after-first-login"

# Comma-separated list of allowed CORS origins, e.g.
# CORS_ALLOWED_ORIGINS="http://localhost:5173,https://ppc.example.com"
# Leave unset for local development — any http(s)://localhost[:port] or
# 127.0.0.1[:port] origin is allowed automatically when NODE_ENV is not
# "production". Must be set to the real frontend's deployed origin(s) before
# running with NODE_ENV=production — see README "Security Hardening
# (Post-Audit)"; left unset in production, all cross-origin browser requests
# are rejected.
CORS_ALLOWED_ORIGINS=""

# Upstash Redis (REST API) backing the login and forgot-password rate
# limiters — see src/lib/rateLimiter.ts and README "Deploying to Vercel".
# Required in every environment (the app refuses to boot without both, same
# as JWT_SECRET). Create a free database at https://console.upstash.com and
# copy its REST URL/token from the database's "REST API" tab — not the
# TCP/Redis connection string.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
